    {
      "name": "search_tickets",
      "description": "Search Freshdesk tickets by status, priority, tag, type and creation date.\n\nUse for questions like \"unresolved tickets\", \"high-priority open tickets\" or\n\"oldest unresolved tickets\". Give at least one filter or a keyword. Pages hold 30 tickets.\n\nFreshdesk cannot search text, so `keyword` is matched by this connector over at\nmost 90 tickets that match the other filters (search_mode\n\"keyword_scan\"). order=\"oldest_first\" also sorts at most 90\ntickets in the connector. With a keyword or oldest_first, only pages 1-3 exist.\nIn both cases `scanned` and `exhaustive` are set: if `exhaustive` is false, more\nmatching tickets may exist, so tell the user, or follow the note's suggestion\n(usually created_before) to continue the search.\n\nIf the account tags or types its tickets (for example tag \"payment\"), filtering by\n`tag` or `ticket_type` is complete and cheaper than a keyword scan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Status labels, e.g. [\"unresolved\"] (every status except resolved and closed, including custom ones), [\"open\"], [\"pending\"], [\"resolved\"], [\"closed\"]. Accounts may have custom statuses such as \"waiting_on_customer\"; an unknown value returns the list of valid ones.",
            "title": "Status"
          },
          "priority": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "urgent"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. [\"high\", \"urgent\"].",
            "title": "Priority"
          },
          "tag": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact ticket tag.",
            "title": "Tag"
          },
          "ticket_type": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact ticket type, e.g. \"Refund\".",
            "title": "Ticket Type"
          },
          "created_after": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Created on or after (YYYY-MM-DD).",
            "title": "Created After"
          },
          "created_before": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Created on or before (YYYY-MM-DD).",
            "title": "Created Before"
          },
          "keyword": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Words that must all appear in the subject or description (case-insensitive substring match, no stemming: use short stems, e.g. \"fail\" matches \"failed\" and \"failure\").",
            "title": "Keyword"
          },
          "order": {
            "default": "newest_first",
            "description": "Sort by ticket creation time.",
            "enum": [
              "newest_first",
              "oldest_first"
            ],
            "title": "Order",
            "type": "string"
          },
          "page": {
            "default": 1,
            "maximum": 10,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          }
        },
        "title": "search_ticketsArguments"
      },
