# Copy to .env and fill in. Never commit .env.

# Your helpdesk subdomain: "acme" or "acme.freshdesk.com"
FRESHDESK_DOMAIN=your-subdomain.freshdesk.com

# Freshdesk profile settings -> "View API key". Use a restricted-role agent.
FRESHDESK_API_KEY=replace-me

# Optional tuning (defaults shown)
# FRESHDESK_TIMEOUT_SECONDS=10
# FRESHDESK_MAX_ATTEMPTS=3
# FRESHDESK_MAX_RETRY_WAIT_SECONDS=10
